---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { projectSlug, projectUrl, pulseUrl, sortedProjects, sortedPulse } from "../../lib/posts";

const allProjects = await getCollection("projects");
const projects = sortedProjects(allProjects);

const statusLabel: Record<string, string> = {
  active: "Active",
  paused: "Paused",
  completed: "Completed",
  archived: "Archived",
};

const statusColor: Record<string, string> = {
  active: "color:var(--link);background:color-mix(in srgb,var(--link) 12%,transparent);",
  paused: "color:var(--text-muted);background:color-mix(in srgb,var(--text-muted) 12%,transparent);",
  completed: "color:#4caf7d;background:color-mix(in srgb,#4caf7d 12%,transparent);",
  archived: "color:var(--text-muted);background:color-mix(in srgb,var(--text-muted) 8%,transparent);",
};

function shortLabel(title: string): string {
  return title.length > 24 ? `${title.slice(0, 21)}…` : title;
}

const includeDraftPulse = !import.meta.env.PROD;
const recentPulse = sortedPulse(await getCollection("pulse"), includeDraftPulse).slice(0, 5);

// Tab order: AI Pulse first, then each project (already sorted active-first, newest-first).
const tabs = [
  { key: "ai-pulse", hash: "ai-pulse", label: "AI Pulse" },
  ...projects.map(project => ({
    key: `project-${projectSlug(project.id)}`,
    hash: projectSlug(project.id),
    label: project.data.shortTitle ?? shortLabel(project.data.title),
  })),
];
---

<Base title="Projects" description="Long-running projects and workstreams by Chao Tan.">
  <h1>Projects</h1>
  <p style="font-family:var(--font-sans);font-size:0.95rem;color:var(--text-muted);margin-bottom:1.75rem;">
    A weekly AI read, plus long-running workstreams I keep notes and updates on over time.
  </p>

  <div
    role="tablist"
    aria-label="Projects sections"
    style="display:flex;gap:1.25rem;flex-wrap:wrap;border-bottom:1px solid var(--border);margin-bottom:1.75rem;"
  >
    {tabs.map((tab, i) => (
      <button
        type="button"
        id={`tab-${tab.key}`}
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        aria-controls={`panel-${tab.key}`}
        data-tab={tab.key}
        data-hash={tab.hash}
        style={`font-family:var(--font-sans);font-size:0.9rem;font-weight:${i === 0 ? "600" : "400"};color:${i === 0 ? "var(--link)" : "var(--text-muted)"};background:none;border:none;border-bottom:2px solid ${i === 0 ? "var(--link)" : "transparent"};padding:0 0 0.6rem;margin-bottom:-1px;cursor:pointer;white-space:nowrap;`}
      >
        {tab.label}
      </button>
    ))}
  </div>

  <div id="panel-ai-pulse" role="tabpanel" aria-labelledby="tab-ai-pulse">
    <p style="font-family:var(--font-sans);font-size:0.95rem;color:var(--text-muted);margin-bottom:1.5rem;">
      A weekly read on what materially changed in AI — grouped by theme, linked to primary sources.
    </p>

    {recentPulse.length === 0 && (
      <p style="font-family:var(--font-sans);color:var(--text-muted);">No reports yet.</p>
    )}

    <ul style="list-style:none;padding:0;margin:0 0 1.25rem;">
      {recentPulse.map(report => (
        <li style="display:flex;gap:1rem;align-items:baseline;padding:0.4rem 0;border-bottom:1px solid var(--border);flex-wrap:wrap;">
          <time
            datetime={report.data.date.toISOString()}
            style="font-family:var(--font-sans);font-size:0.85rem;color:var(--text-muted);white-space:nowrap;min-width:6rem;"
          >
            {report.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" })}
          </time>
          <a href={pulseUrl(report.id)}>{report.data.title}</a>
        </li>
      ))}
    </ul>

    <a href="/pulse/" style="font-family:var(--font-sans);font-size:0.9rem;font-weight:500;">
      View all AI Pulse →
    </a>
  </div>

  {projects.length === 0 && (
    <p style="font-family:var(--font-sans);color:var(--text-muted);">No projects yet.</p>
  )}

  {projects.map(project => {
    const displayDate = project.data.updated ?? project.data.started;
    const dateLabel = project.data.updated ? "updated" : "started";
    return (
      <div id={`panel-project-${projectSlug(project.id)}`} role="tabpanel" aria-labelledby={`tab-project-${projectSlug(project.id)}`}>
        <div style="display:flex;gap:0.625rem;align-items:flex-start;flex-wrap:wrap;margin-bottom:0.375rem;">
          <a
            href={projectUrl(project.id)}
            style="font-family:var(--font-sans);font-size:1.1rem;font-weight:500;"
          >
            {project.data.title}
          </a>
          <span style={`font-family:var(--font-sans);font-size:0.7rem;font-weight:600;padding:0.15rem 0.5rem;border-radius:999px;${statusColor[project.data.status]}`}>
            {statusLabel[project.data.status]}
          </span>
        </div>
        {project.data.description && (
          <p style="font-family:var(--font-sans);font-size:0.9rem;color:var(--text-muted);margin:0 0 0.5rem;">
            {project.data.description}
          </p>
        )}
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
          <time
            datetime={displayDate.toISOString()}
            style="font-family:var(--font-sans);font-size:0.8rem;color:var(--text-muted);"
          >
            {dateLabel} {displayDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
          </time>
          {project.data.tags.length > 0 && (
            <span style="color:var(--border);">·</span>
          )}
          {project.data.tags.map(tag => (
            <a
              href={`/tags/${tag}/`}
              class="tag-pill"
              style="font-size:0.75rem;"
            >
              {tag}
            </a>
          ))}
        </div>
      </div>
    );
  })}
</Base>

<script>
  function initProjectsTabs() {
    const tablist = document.querySelector('[role="tablist"][aria-label="Projects sections"]');
    if (!tablist) return;

    const tabButtons = Array.from(tablist.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const panels = new Map<string, HTMLElement>();
    for (const tab of tabButtons) {
      const key = tab.dataset.tab;
      const panel = key ? document.getElementById(`panel-${key}`) : null;
      if (key && panel) panels.set(key, panel);
    }

    function activate(tabKey: string, updateHash: boolean) {
      for (const tab of tabButtons) {
        const isActive = tab.dataset.tab === tabKey;
        tab.setAttribute("aria-selected", String(isActive));
        tab.style.color = isActive ? "var(--link)" : "var(--text-muted)";
        tab.style.fontWeight = isActive ? "600" : "400";
        tab.style.borderBottomColor = isActive ? "var(--link)" : "transparent";
      }
      for (const [key, panel] of panels) {
        panel.hidden = key !== tabKey;
      }
      if (updateHash) {
        const activeTab = tabButtons.find(t => t.dataset.tab === tabKey);
        const hash = activeTab?.dataset.hash;
        history.replaceState(null, "", location.pathname + (hash ? `#${hash}` : ""));
      }
    }

    for (const tab of tabButtons) {
      tab.addEventListener("click", () => activate(tab.dataset.tab ?? "", true));
    }

    const currentHash = location.hash.replace(/^#/, "");
    const matched = tabButtons.find(t => t.dataset.hash === currentHash);
    activate(matched?.dataset.tab ?? tabButtons[0]?.dataset.tab ?? "", false);
  }

  initProjectsTabs();
  document.addEventListener("astro:after-swap", initProjectsTabs);
</script>
