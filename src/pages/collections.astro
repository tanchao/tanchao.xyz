---
import Base from "../layouts/Base.astro";
import { collections } from "../data/collections";
---

<Base
  title="Collections"
  description="Links Chao Tan endorses — papers, specs, and artifacts worth keeping."
>
  <h1>Collections</h1>
  <p style="font-family:var(--font-sans);font-size:0.875rem;color:var(--text-muted);margin-bottom:2rem;">
    Things I'd point someone at. URL + a few words on why — not a reading diary.
  </p>

  <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:1.25rem;">
    {collections.map((item) => (
      <li style="border-bottom:1px solid var(--border);padding-bottom:1.25rem;">
        <a
          href={item.url}
          rel="noopener"
          style="font-family:var(--font-sans);font-weight:600;color:var(--link);text-decoration:none;"
        >
          {item.title}
        </a>
        <p style="font-family:var(--font-serif);margin:0.35rem 0 0;color:var(--text);line-height:1.5;">
          {item.description}
        </p>
        <p style="font-family:var(--font-sans);font-size:0.8rem;color:var(--text-muted);margin:0.4rem 0 0;word-break:break-all;">
          {item.url}
        </p>
      </li>
    ))}
  </ul>
</Base>
